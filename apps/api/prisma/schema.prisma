// Data model mirrors §06 of the WhatsApp ERP Blueprint plan.
// Single-company scope: no tenant column anywhere, no row-level isolation to
// enforce — every table belongs to the one business running this app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
  MARKETER
  VIEWER
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
}

enum QualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum MessagingTier {
  TIER_250
  TIER_2K
  TIER_10K
  TIER_100K
  UNLIMITED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  isSuperAdmin Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogEntries AuditLogEntry[]
  invitesSent     Invite[]        @relation("InvitedBy")
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role      @default(AGENT)
  token       String    @unique
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model PaymentMethod {
  id                   String   @id @default(cuid())
  type                 String   // CREDIT_CARD, DEBIT_CARD, UPI, META_BILLING
  name                 String
  provider             String   // VISA, MASTERCARD, RAZORPAY, META
  last4                String?
  expiry               String?
  billingEmail         String?
  isDefault            Boolean  @default(false)
  status               String   @default("ACTIVE")
  metaBillingAccountId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Singleton — exactly one row, the app's own WABA. Enforced in code
// (WhatsappIntegrationService.getOrCreate), not by a DB constraint.
// businessTokenEnc is the System User permanent token (§03) — store encrypted.
model WabaConnection {
  id                 String        @id @default(cuid())
  wabaId             String        @unique
  phoneNumberId      String        @unique
  displayPhoneNumber String?
  businessTokenEnc   String
  tier               MessagingTier @default(TIER_250)
  qualityRating      QualityRating @default(UNKNOWN)
  connectedAt        DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Template {
  id             String           @id @default(cuid())
  name           String
  language       String
  category       TemplateCategory
  status         TemplateStatus   @default(DRAFT)
  metaTemplateId String?
  bodyJson       Json
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  campaigns Campaign[]

  @@unique([name, language])
}

model Contact {
  id          String    @id @default(cuid())
  phone       String    @unique
  displayName String?
  optedIn     Boolean   @default(false)
  optedInAt   DateTime?
  tags        String[]
  attributes  Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  conversations Conversation[]
}

model Conversation {
  id              String    @id @default(cuid())
  contact         Contact   @relation(fields: [contactId], references: [id])
  contactId       String
  windowExpiresAt DateTime? // end of the current 24h free-form session window
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages Message[]

  @@index([contactId])
}

model Message {
  id             String           @id @default(cuid())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  conversationId String
  direction      MessageDirection
  status         MessageStatus    @default(QUEUED)
  metaMessageId  String?
  templateId     String?
  payloadJson    Json
  errorCode      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conversationId])
  @@index([metaMessageId])
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  template    Template       @relation(fields: [templateId], references: [id])
  templateId  String
  status      CampaignStatus @default(DRAFT)
  scheduledAt DateTime?
  segmentJson Json // filter/segment definition, e.g. { tags: ["vip"] }
  stats       Json? // { queued, sent, delivered, read, failed }
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// Append-only. Never update or delete rows — write new entries only.
model AuditLogEntry {
  id           String   @id @default(cuid())
  actor        User     @relation(fields: [actorId], references: [id])
  actorId      String
  actorRole    Role
  action       String
  metadataJson Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
}
