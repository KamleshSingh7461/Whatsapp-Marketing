# --- Core ---
NODE_ENV=development
PORT=3000

# --- Database / cache ---
DATABASE_URL="postgresql://whatsapp_erp:whatsapp_erp@localhost:5433/whatsapp_erp?schema=public"
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="8h"

# --- Secrets at rest ---
# 32-byte key, base64-encoded (e.g. `openssl rand -base64 32`). Used to encrypt
# each company's WABA business token before it's stored (see §11 of the plan).
ENCRYPTION_KEY=

# --- Meta / WhatsApp Cloud API (Tech Provider app) ---
# From Meta App Dashboard > App settings > Basic
META_APP_ID=
META_APP_SECRET=
# Arbitrary string you choose; must match what you enter in the webhook config screen
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION="v21.0"
# Permanent token for the platform-level System User (used only for onboarding/token-exchange calls;
# per-company messaging uses the business token obtained via Embedded Signup, stored in waba_connections)
META_SYSTEM_USER_TOKEN=
